<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F5F7FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Inventory"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1F3A5F"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Keep track of your available items"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="24dp" />

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="0">

        <!-- Header -->
        <TableRow>

            <TextView
                android:text="Item"
                android:textStyle="bold"
                android:textSize="16sp"
                android:padding="10dp" />

            <TextView
                android:text="Qty"
                android:textStyle="bold"
                android:textSize="16sp"
                android:padding="10dp" />

            <TextView
                android:text="Action"
                android:textStyle="bold"
                android:textSize="16sp"
                android:padding="10dp" />

        </TableRow>

        <!-- Sample Row 1 -->
        <TableRow>

            <TextView
                android:text="Printer Paper"
                android:padding="10dp" />

            <TextView
                android:text="25"
                android:padding="10dp" />

            <Button
                android:text="Delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </TableRow>

        <!-- Sample Row 2 -->
        <TableRow>

            <TextView
                android:text="Ink Cartridges"
                android:padding="10dp" />

            <TextView
                android:text="8"
                android:padding="10dp" />

            <Button
                android:text="Delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </TableRow>

        <!-- Sample Row 3 -->
        <TableRow>

            <TextView
                android:text="Shipping Boxes"
                android:padding="10dp" />

            <TextView
                android:text="14"
                android:padding="10dp" />

            <Button
                android:text="Delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </TableRow>

    </TableLayout>

    <Button
        android:id="@+id/buttonAddItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Add New Item"
        android:textSize="16sp"
        android:layout_marginTop="30dp" />

    <Button
        android:id="@+id/buttonNotifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Notification Settings"
        android:textSize="16sp"
        android:layout_marginTop="12dp" />

</LinearLayout>