   "source": [
    "# Setup the Jupyter version of Dash\n",
    "from jupyter_dash import JupyterDash\n",
    "\n",
    "# Configure the necessary Python module imports for dashboard components\n",
    "import dash_leaflet as dl\n",
    "from dash import dcc\n",
    "from dash import html\n",
    "import plotly.express as px\n",
    "from dash import dash_table\n",
    "from dash.dependencies import Input, Output\n",
    "import base64\n",
    "import os\n",
    "import pandas as pd\n",
    "\n",
    "# Configure the CRUD module import\n",
    "from animal_shelter import AnimalShelter\n",
    "\n",
    "###########################\n",
    "# Data Manipulation / Model\n",
    "###########################\n",
    "\n",
    "# CS 499 enhancement: credentials are read from environment variables instead\n",
    "# of being stored directly in the notebook. Set AAC_DB_USERNAME and\n",
    "# AAC_DB_PASSWORD before running when authentication is required.\n",
    "username = os.getenv(\"AAC_DB_USERNAME\")\n",
    "password = os.getenv(\"AAC_DB_PASSWORD\")\n",
    "\n",
    "# Connect to database via CRUD Module\n",
    "db = AnimalShelter(username=username, password=password)\n",
    "\n",
    "# Keeping the rescue queries in one place makes them easier to read, test, and update.\n",
    "RESCUE_QUERIES = {\n",
    "    'water': {\n",
    "        'animal_type': 'Dog',\n",
    "        'sex_upon_outcome': 'Intact Female',\n",
    "        'age_upon_outcome_in_weeks': {'$gte': 26, '$lte': 156},\n",
    "        'breed': {\n",
    "            '$regex': 'Labrador Retriever|Chesapeake Bay Retriever|Newfoundland',\n",
    "            '$options': 'i'\n",
    "        }\n",
    "    },\n",
    "    'mountain': {\n",
    "        'animal_type': 'Dog',\n",
    "        'sex_upon_outcome': 'Intact Male',\n",
    "        'age_upon_outcome_in_weeks': {'$gte': 26, '$lte': 156},\n",
    "        'breed': {\n",
    "            '$regex': 'German Shepherd|Alaskan Malamute|Old English Sheepdog|Siberian Husky|Rottweiler',\n",
    "            '$options': 'i'\n",
    "        }\n",
    "    },\n",
    "    'disaster': {\n",
    "        'animal_type': 'Dog',\n",
    "        'sex_upon_outcome': 'Intact Male',\n",
    "        'age_upon_outcome_in_weeks': {'$gte': 20, '$lte': 300},\n",
    "        'breed': {\n",
    "            '$regex': 'Doberman Pinscher|German Shepherd|Golden Retriever|Bloodhound|Rottweiler',\n",
    "            '$options': 'i'\n",
    "        }\n",
    "    },\n",
    "    'reset': {}\n",
    "}\n",
    "\n",
    "\n",
    "def query_to_dataframe(query):\n",
    "    \"\"\"Run a validated MongoDB query and return a clean DataFrame.\"\"\"\n",
    "    if not isinstance(query, dict):\n",
    "        query = {}\n",
    "\n",
    "    records = db.read(query)\n",
    "    df = pd.DataFrame.from_records(records)\n",
    "\n",
    "    if '_id' in df.columns:\n",
    "        df.drop(columns=['_id'], inplace=True)\n",
    "\n",
    "    return df\n",
    "\n",
    "\n",
    "# Start with the full, unfiltered data set\n",
    "df = query_to_dataframe({})\n",
    "\n",
    "#########################\n",
    "# Dashboard Layout / View\n",
    "#########################\n",
    "app = JupyterDash(__name__)\n",
    "\n",
    "# Grazioso Salvare logo\n",
    "image_filename = 'Grazioso Salvare Logo.png'\n",
    "with open(image_filename, 'rb') as image_file:\n",
    "    encoded_image = base64.b64encode(image_file.read())\n",
    "\n",
    "app.layout = html.Div([\n",
    "    html.Center(html.B(html.H1('CS-340 Dashboard'))),\n",
    "\n",
    "    html.Center([\n",
    "        html.A(\n",
    "            html.Img(\n",
    "                src='data:image/png;base64,{}'.format(encoded_image.decode()),\n",
    "                style={'height': '250px'}\n",
    "            ),\n",
    "            href='https://www.snhu.edu',\n",
    "            target='_blank'\n",
    "        ),\n",
    "        html.H3('Created by Savanna Neace')\n",
    "    ]),\n",
    "\n",
    "    html.Hr(),\n",
    "\n",
    "    html.Div([\n",
    "        html.H3('Rescue Type Filter'),\n",
    "        dcc.RadioItems(\n",
    "            id='filter-type',\n",
    "            options=[\n",
    "                {'label': 'Water Rescue', 'value': 'water'},\n",
    "                {'label': 'Mountain or Wilderness Rescue', 'value': 'mountain'},\n",
    "                {'label': 'Disaster or Individual Tracking', 'value': 'disaster'},\n",
    "                {'label': 'Reset', 'value': 'reset'}\n",
    "            ],\n",
    "            value='reset',\n",
    "            inline=True,\n",
    "            inputStyle={'margin-left': '15px', 'margin-right': '5px'}\n",
    "        )\n",
    "    ]),\n",
    "\n",
    "    html.Hr(),\n",
    "\n",
    "    dash_table.DataTable(\n",
    "        id='datatable-id',\n",
    "        columns=[{\"name\": i, \"id\": i, \"deletable\": False, \"selectable\": True} for i in df.columns],\n",
    "        data=df.to_dict('records'),\n",
    "        page_size=10,\n",
    "        sort_action='native',\n",
    "        filter_action='native',\n",
    "        row_selectable='single',\n",
    "        selected_rows=[0] if not df.empty else [],\n",
    "        style_table={'overflowX': 'auto'},\n",
    "        style_cell={\n",
    "            'textAlign': 'left',\n",
    "            'minWidth': '100px',\n",
    "            'width': '150px',\n",
    "            'maxWidth': '200px',\n",
    "            'whiteSpace': 'normal'\n",
    "        },\n",
    "        style_header={'fontWeight': 'bold'}\n",
    "    ),\n",
    "\n",
    "    html.Br(),\n",
    "    html.Hr(),\n",
    "\n",
    "    html.Div(\n",
    "        className='row',\n",
    "        style={'display': 'flex'},\n",
    "        children=[\n",
    "            html.Div(id='graph-id', className='col s12 m6', style={'width': '50%'}),\n",
    "            html.Div(id='map-id', className='col s12 m6', style={'width': '50%'})\n",
    "        ]\n",
    "    )\n",
    "])\n",
    "\n",
    "#############################################\n",
    "# Interaction Between Components / Controller\n",
    "#############################################\n",
    "\n",
    "@app.callback(\n",
    "    Output('datatable-id', 'data'),\n",
    "    [Input('filter-type', 'value')]\n",
    ")\n",
    "def update_dashboard(filter_type):\n",
    "    \"\"\"Filter the dashboard data according to the selected rescue type.\"\"\"\n",
    "    query = RESCUE_QUERIES.get(filter_type, {})\n",
    "    filtered_df = query_to_dataframe(query)\n",
    "    return filtered_df.to_dict('records')\n",
    "\n",
    "\n",
    "@app.callback(\n",
    "    Output('graph-id', 'children'),\n",
    "    [Input('datatable-id', 'derived_virtual_data')]\n",
    ")\n",
    "def update_graphs(view_data):\n",
    "    \"\"\"Display a pie chart of breeds from the currently filtered data.\"\"\"\n",
    "    if not view_data:\n",
    "        return [html.H4('No data available for this filter.')]\n",
    "\n",
    "    dff = pd.DataFrame.from_dict(view_data)\n",
    "    if 'breed' not in dff.columns or dff.empty:\n",
    "        return [html.H4('No breed data available.')]\n",
    "\n",
    "    breed_counts = dff['breed'].dropna().value_counts().reset_index()\n",
    "    breed_counts.columns = ['breed', 'count']\n",
    "\n",
    "    return [\n",
    "        dcc.Graph(\n",
    "            figure=px.pie(\n",
    "                breed_counts,\n",
    "                names='breed',\n",
    "                values='count',\n",
    "                title='Preferred Rescue Dog Breeds'\n",
    "            )\n",
    "        )\n",
    "    ]\n",
    "\n",
    "\n",
    "@app.callback(\n",
    "    Output('datatable-id', 'style_data_conditional'),\n",
    "    [Input('datatable-id', 'selected_columns')]\n",
    ")\n",
    "def update_styles(selected_columns):\n",
    "    selected_columns = selected_columns or []\n",
    "    return [{\n",
    "        'if': {'column_id': column},\n",
    "        'background_color': '#D2F3FF'\n",
    "    } for column in selected_columns]\n",
    "\n",
    "\n",
    "@app.callback(\n",
    "    Output('map-id', 'children'),\n",
    "    [Input('datatable-id', 'derived_virtual_data'),\n",
    "     Input('datatable-id', 'derived_virtual_selected_rows')]\n",
    ")\n",
    "def update_map(view_data, selected_rows):\n",
    "    \"\"\"Display the selected animal on the geolocation map.\"\"\"\n",
    "    if not view_data:\n",
    "        return [html.H4('No map data available for this filter.')]\n",
    "\n",
    "    dff = pd.DataFrame.from_dict(view_data)\n",
    "    required_columns = {'location_lat', 'location_long', 'breed', 'name'}\n",
    "    if not required_columns.issubset(dff.columns):\n",
    "        return [html.H4('Map cannot be displayed because location columns are missing.')]\n",
    "\n",
    "    row = selected_rows[0] if selected_rows else 0\n",
    "    if row >= len(dff):\n",
    "        row = 0\n",
    "\n",
    "    latitude = pd.to_numeric(dff.iloc[row]['location_lat'], errors='coerce')\n",
    "    longitude = pd.to_numeric(dff.iloc[row]['location_long'], errors='coerce')\n",
    "    if pd.isna(latitude) or pd.isna(longitude):\n",
    "        return [html.H4('This animal does not have valid map coordinates.')]\n",
    "\n",
    "    animal_name = dff.iloc[row]['name']\n",
    "    if pd.isna(animal_name) or str(animal_name).strip() == '':\n",
    "        animal_name = 'No name listed'\n",
    "\n",
    "    return [\n",
    "        dl.Map(\n",
    "            style={'width': '100%', 'height': '500px'},\n",
    "            center=[latitude, longitude],\n",
    "            zoom=10,\n",
    "            children=[\n",
    "                dl.TileLayer(id='base-layer-id'),\n",
    "                dl.Marker(\n",
    "                    position=[latitude, longitude],\n",
    "                    children=[\n",
    "                        dl.Tooltip(str(dff.iloc[row]['breed'])),\n",
    "                        dl.Popup([\n",
    "                            html.H1('Animal Name'),\n",
    "                            html.P(str(animal_name))\n",
    "                        ])\n",
    "                    ]\n",
    "                )\n",
    "            ]\n",
    "        )\n",
    "    ]\n",
    "\n",
    "\n",
    "app.run_server(debug=True)\n"
   ]
  }
